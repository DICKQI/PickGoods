# ==================== SHIGU 后端环境变量 ====================
# 复制此文件为 .env 并填入你自己的值
# .env 已加入 .gitignore，不会被提交到 Git

# --- Django ---
# Django 密钥，用于 session/CSRF/签名等
# 生成方式：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-django-secret-key-here

# SQLite 数据库路径；不设置时使用当前 worktree/backend/db.sqlite3
# PICKGOODS_DB_PATH=

# --- JWT ---
# JWT 签名密钥（可选，默认使用 DJANGO_SECRET_KEY）
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET=your-jwt-secret-here

# --- 注册验证码 ---
# 注册图形验证码紧急开关（可选，默认开启）。
# REGISTER_CAPTCHA_ENABLED=true

# DRF 可信反向代理层数（默认 0，单层 Nginx 且后端仅允许 Nginx 访问时可设为 1）。
# DRF_NUM_PROXIES=0

# --- Bangumi API ---
# BGM.tv Access Token（可选，不设置则无法使用 BGM 搜索/关联功能）
# 获取方式：https://bgm.tv/dev/app 创建应用后获取
# BGM_ACCESS_TOKEN=your-bgm-access-token-here

# --- BGM 自动同步 ---
# 关闭进程内调度器（可选）。设为 1 后定时自动同步不再触发，手动触发仍可用。
# 适用于 CI / 临时停调度等场景；生产环境正常使用时无需设置。
# BGM_SCHEDULER_DISABLED=1

# 僵尸任务回收阈值（小时，可选，默认 2）。
# worker 崩溃 / 被 kill 后，running 状态超过此时长的任务会在下次触发同步时
# 被自动标记为 failed，避免死任务永久阻塞。合法范围 [0.5, 72]。
# 当已绑定 BGM 的 IP 数量很大、单次合法同步可能超过 2 小时时，应调大此值，
# 防止仍在正常执行的任务被误判为僵尸回收。
# BGM_ZOMBIE_TIMEOUT_HOURS=2

# --- 谷子主图视觉匹配 ---
# ONNX 模型路径（默认 backend/models/goods_match/model_quantized.onnx）
# GOODS_IMAGE_MATCH_MODEL_PATH=/path/to/model_quantized.onnx
# 每个 Gunicorn worker 的 ONNX 推理线程数（默认 4）
# GOODS_IMAGE_MATCH_MODEL_THREADS=4
# pHash 直达最大汉明距离（默认 6）
# GOODS_IMAGE_MATCH_PHASH_DISTANCE_MAX=6
# 高置信向量相似度与领先幅度（默认 0.94 / 0.03）
# GOODS_IMAGE_MATCH_EMBEDDING_MIN=0.94
# GOODS_IMAGE_MATCH_MARGIN_MIN=0.03
# 候选最低相似度（默认 0.84）
# GOODS_IMAGE_MATCH_CANDIDATE_MIN=0.84
# 局部特征重排的粗排候选数、参与均值的 patch 数和融合权重
# GOODS_IMAGE_MATCH_RERANK_LIMIT=8
# GOODS_IMAGE_MATCH_PATCH_TOP_K=16
# GOODS_IMAGE_MATCH_PATCH_WEIGHT=0.35
# 谷仓“相似”中主图融合维度占最终 100 分的比例（默认 25）
# GOODS_SIMILAR_IMAGE_WEIGHT=25
